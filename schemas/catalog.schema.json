{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.haptique.io/kitchen/catalog.schema.json",
  "title": "Haptique Kitchen Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "registryUrl",
    "packages",
    "blocked",
    "deprecated"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "registryUrl": {
      "type": "string",
      "format": "uri"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "haptique.package.schema.json"
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "deprecated": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "replacementId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
